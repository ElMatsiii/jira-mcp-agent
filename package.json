{
  "name": "jira-mcp-agent",
  "version": "1.0.0",
  "description": "AI Scrum Master via Model Context Protocol (MCP) and Google Gemini 2.0 Flash with Offline Fallback Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage && node scripts/check-coverage.js",
    "coverage:check": "node scripts/check-coverage.js coverage/coverage-summary.json 60.0",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'coverage'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }));\""
  },
  "dependencies": {
    "@google/genai": "~2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "jira",
    "mcp",
    "modelcontextprotocol",
    "gemini",
    "gemini-2.0-flash",
    "scrum-master",
    "agile",
    "typescript"
  ],
  "author": "Jira AI Platform Team",
  "license": "UNLICENSED"
}
